    { "action": "click_proceed" },

    { "action": "wait_for", "selector": "input[data-testid='regtoken-text']", "timeout_ms": 30000 },
    { "action": "sleep", "ms": 1000 },
    { "action": "fill", "selector": "input[data-testid='regtoken-text']", "value": "{{registration_token}}", "delay_ms": 80 },
    { "action": "screenshot", "name": "bpc_step2_regtoken_filled" },
    { "action": "wait_for_proceed_enabled" },
    { "action": "click_proceed" },

    { "action": "wait_for", "selector": "input[data-testid='key-alias-input']", "timeout_ms": 30000 },
    { "action": "sleep", "ms": 1000 },
    { "action": "fill", "selector": "input[data-testid='key-alias-input']", "value": "{{alias}}", "delay_ms": 80 },
    { "action": "fill", "selector": "input[data-testid='key-store-password-input']", "value": "{{key_password}}", "delay_ms": 80 },
    { "action": "screenshot", "name": "bpc_step3_signing_key_filled" },
    { "action": "wait_for_proceed_enabled" },
    { "action": "click_proceed" },

    { "action": "wait_for", "selector": "input[data-testid='business-payment-controls-mastercard-encryption-key-alias-input']", "timeout_ms": 30000 },
    { "action": "sleep", "ms": 1000 },
    { "action": "fill", "selector": "input[data-testid='business-payment-controls-mastercard-encryption-key-alias-input']", "value": "{{alias}}enc", "delay_ms": 80 },
    { "action": "fill", "selector": "input[data-testid='business-payment-controls-mastercard-encryption-key-store-password-input']", "value": "{{key_password}}", "delay_ms": 80 },
    { "action": "screenshot", "name": "bpc_step4_encryption_key_filled" },

    { "action": "wait_for", "selector": "button:has-text('Create project'):not([disabled])", "timeout_ms": 20000 },
    { "action": "screenshot", "name": "bpc_step4_create_ready" },
    { "action": "click", "selector": "button:has-text('Create project')", "timeout_ms": 20000 },
    { "action": "wait_for", "selector": "button[data-testid='download-key-action-project-creation']", "timeout_ms": 300000 },

    {
