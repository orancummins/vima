# Transaction Notifications (oauth1_enc)
TRANSACTION_NOTIFICATIONS_CONSUMER_KEY=your-consumer-key-here
TRANSACTION_NOTIFICATIONS_SIGNING_KEY_PATH=config/keys/transaction-notifications.p12
TRANSACTION_NOTIFICATIONS_SIGNING_KEY_ALIAS=transaction_notifications
