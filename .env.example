# Flight Delay Pass (oauth1_enc)
#   Note: Manual onboarding only — issuer must be provisioned as a Flight Delay Pass tenant (~26 days) and the Client Key whitelisted.
#   Manual onboarding: https://developer.mastercard.com/flight-delay-pass/documentation/
FLIGHT_DELAY_PASS_CONSUMER_KEY=your-consumer-key-here
FLIGHT_DELAY_PASS_SIGNING_KEY_PATH=config/keys/flight-delay-pass.p12
FLIGHT_DELAY_PASS_SIGNING_KEY_ALIAS=flight_delay_pass
