TRANSACTION_NOTIFICATIONS_ENV=sandbox
TRANSACTION_NOTIFICATIONS_ENCRYPTION_KEY_PATH=config/keys/transaction-notifications-clientenc.pem

# Enhanced Currency Conversion Calculator (oauth1)
#   Note: Requires API Owner approval
ENHANCED_CURRENCY_CONVERSION_CALCULATOR_CONSUMER_KEY=your-consumer-key-here
ENHANCED_CURRENCY_CONVERSION_CALCULATOR_SIGNING_KEY_PATH=config/keys/enhanced-currency-conversion-calculator.p12
ENHANCED_CURRENCY_CONVERSION_CALCULATOR_SIGNING_KEY_ALIAS=enhanced_currency_conversion_calculator
ENHANCED_CURRENCY_CONVERSION_CALCULATOR_SIGNING_KEY_PASSWORD=keystorepassword
ENHANCED_CURRENCY_CONVERSION_CALCULATOR_ENV=sandbox

# Carbon Calculator (oauth1_enc)
#   Note: Manual onboarding only — requires Mastercard-issued Customer ID, Legal Name and BIN range. Contact carboncalculator@mastercard.com.
#   Manual onboarding: https://developer.mastercard.com/create-project/carbon-calculator?services=carbon-calculator
CARBON_CALCULATOR_CONSUMER_KEY=your-consumer-key-here
CARBON_CALCULATOR_SIGNING_KEY_PATH=config/keys/carbon-calculator.p12
CARBON_CALCULATOR_SIGNING_KEY_ALIAS=carbon_calculator
CARBON_CALCULATOR_SIGNING_KEY_PASSWORD=keystorepassword
CARBON_CALCULATOR_ENV=sandbox
CARBON_CALCULATOR_ENCRYPTION_KEY_PATH=config/keys/carbon-calculator-clientenc.pem

