# =====================================================================
# vima — example environment configuration
#
# Copy to config/.env and fill in real values. Credential variable names
# are derived from each API's env_prefix in apis/catalog.py. Placeholder
# values are safe to commit; real keys/secrets must NOT be committed.
# =====================================================================

# --- Application settings ---
SECRET_KEY=change-me
PORT=9021

# --- Mastercard Developers API (admin key for API-based provisioning) ---
# Bootstrap once with: tools/mcd-key-automation provision-admin-key
MCD_DEVELOPERS_API_CONSUMER_KEY=your-consumer-key-here
MCD_DEVELOPERS_API_SIGNING_KEY_PATH=config/keys/mcd-developers-api.p12
MCD_DEVELOPERS_API_SIGNING_KEY_ALIAS=vima-developers-api
MCD_DEVELOPERS_API_SIGNING_KEY_PASSWORD=keystorepassword

# =====================================================================
# Open Banking & Open Finance
# =====================================================================

# Open Finance US (oauth2)
OPEN_FINANCE_PARTNER_ID=your_partner_id_here
OPEN_FINANCE_PARTNER_SECRET=your_partner_secret_here
OPEN_FINANCE_APP_KEY=your_app_key_here
OPEN_FINANCE_API_BASE_URL=https://api.finicity.com
OPEN_FINANCE_SIG_KEY_PATH=config/keys/open-finance-sig.pem

# Open Finance Australia (oauth2)
OPEN_FINANCE_AU_PARTNER_ID=your_partner_id_here
OPEN_FINANCE_AU_PARTNER_SECRET=your_partner_secret_here
OPEN_FINANCE_AU_APP_KEY=your_app_key_here
OPEN_FINANCE_AU_API_BASE_URL=https://api.finicity.com
OPEN_FINANCE_AU_SIG_KEY_PATH=config/keys/open-finance-au-sig.pem

# Open Finance Europe (jwt_rs256)
#   Note: Manual onboarding only — email openbankingeu_support@mastercard.com with your RSA-4096 public PEM to receive a sandbox clientId.
#   Manual onboarding: https://openbankingeu.mastercard.com/contact-us
OPEN_FINANCE_EU_CLIENT_ID=your_client_id_here
OPEN_FINANCE_EU_PRIVATE_KEY_PATH=config/keys/open-finance-eu-private.pem
OPEN_FINANCE_EU_PUBLIC_CERT_PATH=config/keys/open-finance-eu-public.pem
OPEN_FINANCE_EU_APPLICATION_ID=your_application_id_here
OPEN_FINANCE_EU_USE_CASE_ID=your_use_case_id_here
OPEN_FINANCE_EU_REDIRECT_URL=https://your-app.example.com/callback
OPEN_FINANCE_EU_AUTH_BASE_URL=https://api.openbanking.mastercard.com.eu
OPEN_FINANCE_EU_API_BASE_URL=https://api.openbanking.mastercard.com.eu

# =====================================================================
# Security & Risk
# =====================================================================

# MATCH Pro (oauth1)
MATCH_CONSUMER_KEY=your-consumer-key-here
MATCH_SIGNING_KEY_PATH=config/keys/match.p12
MATCH_SIGNING_KEY_ALIAS=match
MATCH_SIGNING_KEY_PASSWORD=keystorepassword
MATCH_ENV=sandbox

# Consent Management (oauth1_enc)
CONSENT_MANAGEMENT_CONSUMER_KEY=your-consumer-key-here
CONSENT_MANAGEMENT_SIGNING_KEY_PATH=config/keys/consent-management.p12
CONSENT_MANAGEMENT_SIGNING_KEY_ALIAS=consent_management
CONSENT_MANAGEMENT_SIGNING_KEY_PASSWORD=keystorepassword
CONSENT_MANAGEMENT_ENV=sandbox
CONSENT_MANAGEMENT_ENCRYPTION_KEY_PATH=config/keys/consent-management-clientenc.pem

# Business Payment Controls (oauth1)
#   Note: Requires a registration token from your Mastercard Commercial Products implementation manager (default in playbook: 123456789).
BUSINESS_PAYMENT_CONTROLS_CONSUMER_KEY=your-consumer-key-here
BUSINESS_PAYMENT_CONTROLS_SIGNING_KEY_PATH=config/keys/business-payment-controls.p12
BUSINESS_PAYMENT_CONTROLS_SIGNING_KEY_ALIAS=business_payment_controls
BUSINESS_PAYMENT_CONTROLS_SIGNING_KEY_PASSWORD=keystorepassword
BUSINESS_PAYMENT_CONTROLS_ENV=sandbox

