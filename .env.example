# Consumer Clarity (oauth1_enc)
CONSUMER_CLARITY_CONSUMER_KEY=your-consumer-key-here
CONSUMER_CLARITY_SIGNING_KEY_PATH=config/keys/consumer-clarity.p12
CONSUMER_CLARITY_SIGNING_KEY_ALIAS=consumer_clarity
