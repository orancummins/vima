# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=your_api_key_here

# Optional: override the work directory (default: ./test_project)
# WORK_DIR=./test_project

# Simple-mode work directory — the directory the /simple chat is scoped to
# Relative paths are resolved from the directory where the server is started
SIMPLE_WORK_DIR=../vima/testchat

# URL of the running vima instance — used to fetch the /catalog for Use Cases & APIs
# VIMA_URL=http://localhost:9021

# Optional: override the Claude model (default: claude-sonnet-4-5)
# CLAUDE_MODEL=claude-sonnet-4-5
