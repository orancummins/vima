{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "ignorePatterns": [
        "usecases/",
        "chat/",
        "simulator/",
        "tools/",
        "tests/",
        "static/globe.js"
    ],
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off"
    }
}
