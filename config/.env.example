# Generated by mcd-key-automation — copy to .env and fill in your credentials
# Or run provisioning from the UI to generate this automatically.

# -------------------------------------------------------------------
# Mastercard Developers portal login (for automated key provisioning)
# Used by: mcd-key-automation provision-api <url>
#
# If set, the login form is pre-filled automatically.
# You still complete MFA/CAPTCHA when prompted.
# After first successful login, the session is cached in
# tools/mcd-key-automation/session_state.json — subsequent runs are
# fully headless (no browser interaction needed).
# -------------------------------------------------------------------
MCD_PORTAL_EMAIL=your@email.com
MCD_PORTAL_PASSWORD=your-portal-password

SECRET_KEY=change-me
PORT=9021

# Set to true to log all outbound API calls (visible in the API Explorer panel)
LOG_API_CALLS=false

# BIN LOOKUP (Mastercard OAuth 1.0a)
BIN_LOOKUP_CONSUMER_KEY=your-consumer-key-here
BIN_LOOKUP_SIGNING_KEY_PATH=config/keys/bin_lookup.p12
BIN_LOOKUP_SIGNING_KEY_ALIAS=binlookup
BIN_LOOKUP_SIGNING_KEY_PASSWORD=keystorepassword
BIN_LOOKUP_ENV=sandbox

# CONSUMER CLARITY (Mastercard OAuth 1.0a)
CONSUMER_CLARITY_CONSUMER_KEY=your-consumer-key-here
CONSUMER_CLARITY_SIGNING_KEY_PATH=config/keys/consumer_clarity.p12
CONSUMER_CLARITY_SIGNING_KEY_ALIAS=clarity-signing
CONSUMER_CLARITY_SIGNING_KEY_PASSWORD=keystorepassword
CONSUMER_CLARITY_ENV=sandbox
CONSUMER_CLARITY_ENCRYPTION_KEY_PATH=

# PRICELESS CITIES (Mastercard OAuth 1.0a)
PRICELESS_CITIES_CONSUMER_KEY=your-consumer-key-here
PRICELESS_CITIES_SIGNING_KEY_PATH=config/keys/priceless_cities.p12
PRICELESS_CITIES_SIGNING_KEY_ALIAS=priceless
PRICELESS_CITIES_SIGNING_KEY_PASSWORD=keystorepassword
PRICELESS_CITIES_ENV=sandbox

# EASY SAVINGS (Mastercard OAuth 1.0a)
EASY_SAVINGS_CONSUMER_KEY=your-consumer-key-here
EASY_SAVINGS_SIGNING_KEY_PATH=config/keys/easy_savings.p12
EASY_SAVINGS_SIGNING_KEY_ALIAS=easysavings
EASY_SAVINGS_SIGNING_KEY_PASSWORD=keystorepassword
EASY_SAVINGS_ENV=sandbox

# PLACES (Mastercard OAuth 1.0a)
PLACES_CONSUMER_KEY=your-consumer-key-here
PLACES_SIGNING_KEY_PATH=config/keys/places.p12
PLACES_SIGNING_KEY_ALIAS=places-signing
PLACES_SIGNING_KEY_PASSWORD=keystorepassword
PLACES_ENV=sandbox

# OFFERS FOR PUBLISHERS (Mastercard OAuth 1.0a)
OFFERS_FOR_PUBLISHERS_CONSUMER_KEY=your-consumer-key-here
OFFERS_FOR_PUBLISHERS_SIGNING_KEY_PATH=config/keys/offers_for_publishers.p12
OFFERS_FOR_PUBLISHERS_SIGNING_KEY_ALIAS=ofpub-signing
OFFERS_FOR_PUBLISHERS_SIGNING_KEY_PASSWORD=keystorepassword
OFFERS_FOR_PUBLISHERS_ENV=sandbox

# OFFERS MERCHANT CONTENT (Mastercard OAuth 1.0a)
OFFERS_MERCHANT_CONTENT_CONSUMER_KEY=your-consumer-key-here
OFFERS_MERCHANT_CONTENT_SIGNING_KEY_PATH=config/keys/offers_merchant_content.p12
OFFERS_MERCHANT_CONTENT_SIGNING_KEY_ALIAS=ofmc-signing
OFFERS_MERCHANT_CONTENT_SIGNING_KEY_PASSWORD=keystorepassword
OFFERS_MERCHANT_CONTENT_ENV=sandbox

# CONSENT MANAGEMENT (Mastercard OAuth 1.0a)
CONSENT_MANAGEMENT_CONSUMER_KEY=your-consumer-key-here
CONSENT_MANAGEMENT_SIGNING_KEY_PATH=config/keys/consent_management.p12
CONSENT_MANAGEMENT_SIGNING_KEY_ALIAS=consent-signing
CONSENT_MANAGEMENT_SIGNING_KEY_PASSWORD=keystorepassword
CONSENT_MANAGEMENT_ENV=sandbox
CONSENT_MANAGEMENT_ENCRYPTION_KEY_PATH=

# TRANSACTION NOTIFICATIONS (Mastercard OAuth 1.0a)
TRANSACTION_NOTIFICATIONS_CONSUMER_KEY=your-consumer-key-here
TRANSACTION_NOTIFICATIONS_SIGNING_KEY_PATH=config/keys/transaction_notifications.p12
TRANSACTION_NOTIFICATIONS_SIGNING_KEY_ALIAS=txnotify
TRANSACTION_NOTIFICATIONS_SIGNING_KEY_PASSWORD=keystorepassword
TRANSACTION_NOTIFICATIONS_ENV=sandbox

# BENEFITS ELIGIBILITY (Mastercard OAuth 1.0a)
BENEFITS_ELIGIBILITY_CONSUMER_KEY=your-consumer-key-here
BENEFITS_ELIGIBILITY_SIGNING_KEY_PATH=config/keys/benefits_eligibility.p12
BENEFITS_ELIGIBILITY_SIGNING_KEY_ALIAS=eligibility
BENEFITS_ELIGIBILITY_SIGNING_KEY_PASSWORD=keystorepassword
BENEFITS_ELIGIBILITY_ENV=sandbox
BENEFITS_ELIGIBILITY_ENCRYPTION_KEY_PATH=

# BENEFITS CONTENT ELIGIBILITY (Mastercard OAuth 1.0a)
BENEFITS_CONTENT_ELIGIBILITY_CONSUMER_KEY=your-consumer-key-here
BENEFITS_CONTENT_ELIGIBILITY_SIGNING_KEY_PATH=config/keys/benefits_content_eligibility.p12
BENEFITS_CONTENT_ELIGIBILITY_SIGNING_KEY_ALIAS=bces-signing
BENEFITS_CONTENT_ELIGIBILITY_SIGNING_KEY_PASSWORD=keystorepassword
BENEFITS_CONTENT_ELIGIBILITY_ENV=sandbox
BENEFITS_CONTENT_ELIGIBILITY_ENCRYPTION_KEY_PATH=

# OPEN FINANCE (Finicity OAuth 2.0)
OPEN_FINANCE_PARTNER_ID=your_partner_id_here
OPEN_FINANCE_PARTNER_SECRET=your_partner_secret_here
OPEN_FINANCE_APP_KEY=your_app_key_here
OPEN_FINANCE_API_BASE_URL=https://api.finicity.com
OPEN_FINANCE_SIG_KEY_PATH=config/keys/open_finance-sig-verification.pem

# OPEN FINANCE AUSTRALIA (Mastercard AU Open Banking — Partner+App auth, no Finicity- prefix)
OPEN_FINANCE_AU_PARTNER_ID=your_partner_id_here
OPEN_FINANCE_AU_PARTNER_SECRET=your_partner_secret_here
OPEN_FINANCE_AU_APP_KEY=your_app_key_here
OPEN_FINANCE_AU_API_BASE_URL=https://api.openbanking.mastercard.com.au

# OPEN FINANCE EUROPE (Aiia — OAuth 2.0 / JWT client-assertion, RS256)
# Generate keys with:
#   openssl req -x509 -sha256 -nodes -newkey rsa:4096 \
#     -keyout config/keys/eu-ofin-private.key -days 730 \
#     -out    config/keys/eu-ofin-public.pem
# Email the resulting public PEM to openbankingeu_support@mastercard.com to
# receive a sandbox clientId.
OPEN_FINANCE_EU_CLIENT_ID=your_client_id_here
OPEN_FINANCE_EU_PRIVATE_KEY_PATH=config/keys/eu-ofin-private.key
OPEN_FINANCE_EU_PUBLIC_CERT_PATH=config/keys/eu-ofin-public.pem
OPEN_FINANCE_EU_AUTH_BASE_URL=https://mtf.auth.openbanking.mastercard.eu
OPEN_FINANCE_EU_API_BASE_URL=https://mtf.api.openbanking.mastercard.eu

# CLAUDE / VIMA CHAT
ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
