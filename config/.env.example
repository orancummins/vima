# Mastercard Open Finance (Finicity) Credentials
PARTNER_ID=your_partner_id_here
PARTNER_SECRET=your_partner_secret_here
APP_KEY=your_app_key_here
API_BASE_URL=https://api.finicity.com
OFIN_DEFAULT_CUSTOMER_ID=

SECRET_KEY=change-me
PORT=9021

# Set to true to log all outbound API calls (visible in the API Explorer panel)
LOG_API_CALLS=false


# BIN Lookup (Mastercard OAuth 1.0a)
BINLOOKUP_CONSUMER_KEY=your-consumer-key-here
BINLOOKUP_SIGNING_KEY_PATH=config/keys/binlookup.p12
BINLOOKUP_SIGNING_KEY_ALIAS=binlookup
BINLOOKUP_SIGNING_KEY_PASSWORD=binlookup1
BINLOOKUP_ENV=sandbox

# CONSUMER CLARITY (Mastercard OAuth 1.0a)
CONSUMERCLARITY_CONSUMER_KEY=your-consumer-key-here
CONSUMERCLARITY_SIGNING_KEY_PATH=config/keys/consumerclarity.p12
CONSUMERCLARITY_SIGNING_KEY_ALIAS=consumerclarity
CONSUMERCLARITY_SIGNING_KEY_PASSWORD=consumerclarity1
CONSUMERCLARITY_ENV=sandbox

# PRICELESS (Mastercard OAuth 1.0a)
PRICELESS_CONSUMER_KEY=your-consumer-key-here
PRICELESS_SIGNING_KEY_PATH=config/keys/pricelessgroup.p12
PRICELESS_SIGNING_KEY_ALIAS=pricelessgroup
PRICELESS_SIGNING_KEY_PASSWORD=pricelessgroup1
PRICELESS_ENV=sandbox

# EASY SAVINGS (Mastercard OAuth 1.0a)
EASYSAVINGS_CONSUMER_KEY=your-consumer-key-here
EASYSAVINGS_SIGNING_KEY_PATH=config/keys/easysavings.p12
EASYSAVINGS_SIGNING_KEY_ALIAS=easysavings
EASYSAVINGS_SIGNING_KEY_PASSWORD=easysavings1
EASYSAVINGS_ENV=sandbox

# PLACES (Mastercard OAuth 1.0a)
PLACES_CONSUMER_KEY=your-consumer-key-here
PLACES_SIGNING_KEY_PATH=config/keys/places.p12
PLACES_SIGNING_KEY_ALIAS=places
PLACES_SIGNING_KEY_PASSWORD=places1
PLACES_ENV=sandbox

# TRANSACTION NOTIFICATIONS (Mastercard OAuth 1.0a)
TXNOTIFY_CONSUMER_KEY=your-consumer-key-here
TXNOTIFY_SIGNING_KEY_PATH=config/keys/your-signing-key.p12
TXNOTIFY_SIGNING_KEY_ALIAS=keyalias
TXNOTIFY_SIGNING_KEY_PASSWORD=keystorepassword
TXNOTIFY_ENV=sandbox

# CONSENT MANAGEMENT (Mastercard OAuth 1.0a)
CONSENT_CONSUMER_KEY=your-consumer-key-here
CONSENT_SIGNING_KEY_PATH=config/keys/your-signing-key.p12
CONSENT_SIGNING_KEY_ALIAS=keyalias
CONSENT_SIGNING_KEY_PASSWORD=keystorepassword
CONSENT_ENV=sandbox
CONSENT_ENCRYPTION_KEY_PATH=

# OFFERS FOR PUBLISHERS (Mastercard OAuth 1.0a)
OFPUB_CONSUMER_KEY=your-consumer-key-here
OFPUB_SIGNING_KEY_PATH=config/keys/your-signing-key.p12
OFPUB_SIGNING_KEY_ALIAS=keyalias
OFPUB_SIGNING_KEY_PASSWORD=keystorepassword
OFPUB_ENV=sandbox

# OFFERS MERCHANT CONTENT (Mastercard OAuth 1.0a)
OFMC_CONSUMER_KEY=your-consumer-key-here
OFMC_SIGNING_KEY_PATH=config/keys/your-signing-key.p12
OFMC_SIGNING_KEY_ALIAS=keyalias
OFMC_SIGNING_KEY_PASSWORD=keystorepassword
OFMC_ENV=sandbox

# BENEFITS ELIGIBILITY (Mastercard OAuth 1.0a)
ELIGIBILITY_CONSUMER_KEY=your-consumer-key-here
ELIGIBILITY_SIGNING_KEY_PATH=config/keys/your-signing-key.p12
ELIGIBILITY_SIGNING_KEY_ALIAS=keyalias
ELIGIBILITY_SIGNING_KEY_PASSWORD=keystorepassword
ELIGIBILITY_ENV=sandbox

# BENEFITS CONTENT ELIGIBILITY SERVICE (Mastercard OAuth 1.0a)
BCES_CONSUMER_KEY=your-consumer-key-here
BCES_SIGNING_KEY_PATH=config/keys/your-signing-key.p12
BCES_SIGNING_KEY_ALIAS=keyalias
BCES_SIGNING_KEY_PASSWORD=keystorepassword
BCES_ENV=sandbox
BCES_ENCRYPTION_CERT_PATH=

# ── Simulated Sandbox ──────────────────────────────────────────────────────────
# Set SIMULATED_SANDBOX=1 to route all APIs through the local simulator
# Set {API_SLUG}_SIMULATED=1 to simulate only that API
SIMULATED_SANDBOX=
BINLOOKUP_SIMULATED=
CLARITY_SIMULATED=
PRICELESS_SIMULATED=
EASYSAVINGS_SIMULATED=
PLACES_SIMULATED=
ELIGIBILITY_SIMULATED=
BCES_SIMULATED=
OFPUB_SIMULATED=
OFMC_SIMULATED=
CONSENT_SIMULATED=
TXNOTIFY_SIMULATED=
OFIN_SIMULATED=

# CLAUDE / VIMA CHAT
ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
